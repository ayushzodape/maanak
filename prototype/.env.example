# Required for server-side Gemini vision extraction.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Credentials for the minimal server-enforced prototype session boundary.
MAANAK_AUTH_USERNAME="configure-a-username"
MAANAK_AUTH_PASSWORD="configure-a-strong-password"
